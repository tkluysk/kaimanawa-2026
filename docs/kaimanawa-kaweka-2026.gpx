<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="kaimanawa-2026" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Kaimanawa to Kaweka traverse, 12-16 Dec 2026</name></metadata>
<wpt lat="-39.2869" lon="176.4078"><name>Makahu Saddle car park</name><desc>Cars wait here all week. Merv collects us at 10:00 on Sat 12 Dec; Kate meets us here on Wed 16 Dec.</desc></wpt>
<wpt lat="-38.9978" lon="176.295"><name>Taharua road end, Poronui (Helisika hangar)</name><desc>Start of the walk. Poled route through private Poronui Station: foot traffic only, no hunting, no dogs.</desc></wpt>
<wpt lat="-39.0763" lon="176.2649"><name>Oamaru Hut</name><desc>Day 1 passes here; the camp is about an hour further up the Oamaru River.</desc></wpt>
<wpt lat="-39.09318" lon="176.23712"><name>Camp 1: Oamaru River</name><desc>Night 1 (Sat 12 Dec). The best campsites, about an hour (3.5 km) past Oamaru Hut up the Oamaru River. Position approximate.</desc></wpt>
<wpt lat="-39.1545" lon="176.1694"><name>Boyd Hut</name><desc>Day 2 passes here: serviced hut, 16 bunks, airstrip. The camp is about 45 min further on.</desc></wpt>
<wpt lat="-39.17424" lon="176.17997"><name>Camp 2: Ngaruroro River</name><desc>Night 2 (Sun 13 Dec). A great spot on the Ngaruroro, about 45 min (2.6 km) past Boyd Hut, past the ford. Position approximate.</desc></wpt>
<wpt lat="-39.1656" lon="176.2153"><name>Tussock Hut</name><desc>Lunch or morning-tea stop on day 3, at the top of the climb from the Ngaruroro.</desc></wpt>
<wpt lat="-39.1955" lon="176.2392"><name>Harkness Hut</name><desc>Night 3 (Mon 14 Dec). Wood stove, rain tank, long drop.</desc></wpt>
<wpt lat="-39.2472" lon="176.3217"><name>Venison Tops Hut (Tira Lodge)</name><desc>Night 4 (Tue 15 Dec). On the edge of the Kaweka tops. DOC alert: broken water tap; a crew is due to fix it on 14 Dec. If it isn't fixed, take the tank lid off and reach in.</desc></wpt>
<wpt lat="-39.2762" lon="176.3819"><name>Kaweka J, 1724 m</name><desc>Highest point of the trip; memorial cairn. Exposed tops.</desc></wpt>
<wpt lat="-39.1935" lon="176.2766"><name>Te Pukeohikarua (Te Puke) Hut</name><desc>Day 4 passes here after about 4 km: a good first break.</desc></wpt>
<wpt lat="-39.2192" lon="176.3299"><name>Mangaturutu Hut</name><desc>Other hut nearby (shelter option).</desc></wpt>
<wpt lat="-39.238" lon="176.3698"><name>Ballard Hut</name><desc>Other hut nearby (shelter option).</desc></wpt>
<trk><name>Day 1 Sat 12 Dec: Taharua road end past Oamaru Hut to camp on the Oamaru River</name><trkseg>
